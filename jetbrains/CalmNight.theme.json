{
  "name": "Calm Night",
  "dark": true,
  "author": "David Domingo",
  "colors": {
    "bg": "#282c34",
    "bgDim": "#21252b",
    "bgDark": "#1b1d23",
    "fg": "#c5c8c6",
    "fgDim": "#969896",
    "fgFaint": "#5c6370",
    "sel": "#373b41",
    "listSel": "#3d4350",
    "hover": "#2c313a",
    "border": "#181a1f",
    "separator": "#30343c",
    "accent": "#f0c674",
    "accentDim": "#8a7a44",
    "green": "#b5bd68",
    "red": "#cc6666",
    "blue": "#81a2be"
  },
  "ui": {
    "*": {
      "background": "bg",
      "foreground": "fg",
      "infoForeground": "fgDim",
      "disabledForeground": "fgFaint",
      "disabledBackground": "bg",
      "disabledText": "fgFaint",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "selectionInactiveBackground": "hover",
      "selectionInactiveForeground": "fg",
      "inactiveBackground": "bg",
      "inactiveForeground": "fgDim",
      "borderColor": "border",
      "disabledBorderColor": "border",
      "focusColor": "accent",
      "focusedBorderColor": "accent",
      "separatorColor": "separator",
      "acceleratorForeground": "fgDim",
      "errorForeground": "red"
    },

    "Panel": { "background": "bg", "foreground": "fg" },
    "Component": {
