        "selectedBackground": "sel",
        "hoverBackground": "hover",
        "underlineColor": "accent",
        "inactiveUnderlineColor": "accentDim"
      }
    },

    "Tree": {
      "background": "bgDim",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "selectionInactiveBackground": "hover",
      "hoverBackground": "hover",
      "rowHeight": 24
    },

    "List": {
      "background": "bgDim",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "selectionInactiveBackground": "hover",
      "hoverBackground": "hover"
    },

    "Table": {
      "background": "bg",
      "foreground": "fg",
      "gridColor": "separator",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "stripeColor": "bgDim"
    },
    "TableHeader": {
      "background": "bgDim",
      "foreground": "fgDim",
      "bottomSeparatorColor": "border"
    },

    "MenuBar": {
      "background": "bgDim",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "borderColor": "border"
