      "default": {
        "startBackground": "#4a4326",
        "endBackground": "#4a4326",
        "foreground": "#eaeaea",
        "startBorderColor": "accentDim",
        "endBorderColor": "accentDim",
        "focusColor": "accent",
        "focusedBorderColor": "accent"
      }
    },

    "TextField": {
      "background": "bgDark",
      "foreground": "fg",
      "caretForeground": "accent",
      "selectionBackground": "sel",
      "borderColor": "border"
    },
