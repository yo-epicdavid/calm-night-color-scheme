      "background": "bgDim",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionInactiveBackground": "hover",
      "matchForeground": "accent",
      "matchSelectedForeground": "accent"
    },

    "NavBar": {
      "background": "bg",
      "borderColor": "border"
    },

    "StatusBar": {
      "background": "bgDim",
      "foreground": "fgDim",
      "borderColor": "border",
      "hoverBackground": "hover"
    },

    "TabbedPane": {
      "background": "bg",
      "foreground": "fg",
      "underlineColor": "accent",
      "hoverColor": "hover",
      "focusColor": "sel",
      "contentAreaColor": "border"
