      "background": "bgDark",
      "foreground": "fg",
      "selectionBackground": "sel",
      "caretForeground": "accent"
    },
    "ComboBox": {
      "background": "bgDark",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
