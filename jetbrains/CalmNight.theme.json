  "icons": {
    "ColorPalette": {
      "Actions.Blue": "#81a2be",
      "Actions.Green": "#b5bd68",
      "Actions.Red": "#cc6666",
      "Actions.Yellow": "#f0c674",
      "Actions.Grey": "#969896",
      "Actions.GreyInline": "#969896",
      "Objects.Blue": "#81a2be",
      "Objects.Green": "#b5bd68",
      "Objects.Grey": "#969896",
      "Objects.Pink": "#c397d8",
      "Objects.Purple": "#b294bb",
      "Objects.Red": "#cc6666",
      "Objects.Yellow": "#f0c674",
      "Objects.YellowDark": "#de935f"
    }
