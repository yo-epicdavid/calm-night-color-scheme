      "background": "bgDim",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "borderColor": "border",
      "separatorColor": "separator"
    },
    "MenuItem": {
      "background": "bgDim",
      "foreground": "fg",
      "selectionBackground": "listSel",
      "selectionForeground": "#eaeaea",
      "disabledForeground": "fgFaint",
      "acceleratorForeground": "fgDim"
    },
    "PopupMenu": {
      "background": "bgDim",
      "foreground": "fg",
      "borderColor": "border",
      "borderInsets": "4,0,4,0"
    },

    "Popup": {
      "background": "bgDim",
      "borderColor": "border",
