        "background": "bgDim",
        "iconColor": "fgDim",
        "disabledIconColor": "fgFaint"
      }
    },

    "CheckBox": { "background": "bg", "foreground": "fg" },
    "RadioButton": { "background": "bg", "foreground": "fg" },

    "Link": {
      "activeForeground": "blue",
      "hoverForeground": "#7aa6da",
      "visitedForeground": "#b294bb",
      "pressedForeground": "blue"
    },

    "ProgressBar": {
      "trackColor": "sel",
      "progressColor": "accent",
      "indeterminateStartColor": "accentDim",
      "indeterminateEndColor": "accent"
    },

    "ScrollBar": {
      "thumbColor": "#3a3f4b",
      "hoverThumbColor": "#4a505c",
      "thumbBorderColor": "#3a3f4b"
    },

    "SearchEverywhere": {
      "SearchField": { "background": "bgDark", "borderColor": "border" },
      "Tab": { "selectedBackground": "sel", "selectedForeground": "#eaeaea" }
    },

    "Notification": {
      "background": "bgDim",
      "foreground": "fg",
      "borderColor": "border",
      "errorBackground": "#3a2e2e",
      "errorBorderColor": "red",
      "errorForeground": "fg",
      "ToolWindow": {
        "informativeBackground": "bgDim",
        "informativeForeground": "fg",
        "informativeBorderColor": "border",
        "warningBackground": "#3a352e",
        "warningForeground": "fg",
        "warningBorderColor": "accentDim",
        "errorBackground": "#3a2e2e",
        "errorForeground": "fg",
        "errorBorderColor": "red"
      }
    },

    "Editor": {
      "background": "bg",
      "shortcutForeground": "accent"
    },
    "EditorPane": { "background": "bg", "inactiveBackground": "bg" },

    "ToolTip": {
      "background": "bgDark",
      "foreground": "fg",
      "borderColor": "border"
