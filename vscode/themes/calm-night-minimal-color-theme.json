  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#969896", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string", "string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#b5bd68" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant"],
      "settings": { "foreground": "#de935f" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#de935f" }
    },
    {
      "scope": [
        "keyword", "keyword.control", "storage.type", "storage.modifier",
        "entity.name.function", "support.function", "meta.function-call.generic",
        "variable", "variable.other", "variable.parameter", "meta.definition.variable",
        "variable.other.property", "meta.object-literal.key", "support.variable.property",
        "entity.name.tag", "punctuation.definition.tag", "entity.other.attribute-name",
        "support.type.property-name", "meta.decorator", "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#c5c8c6" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#969896" }
    },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#de935f", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#b5bd68" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#cc6666" } }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#969896", "fontStyle": "italic" },
    "string": "#b5bd68",
    "number": "#de935f",
    "class": "#de935f",
    "type": "#de935f",
    "interface": "#de935f",
    "enum": "#de935f",
    "enumMember": "#de935f",
    "namespace": "#de935f",
    "keyword": "#c5c8c6",
    "function": "#c5c8c6",
    "method": "#c5c8c6",
    "variable": "#c5c8c6",
    "parameter": "#c5c8c6",
    "property": "#c5c8c6",
    "decorator": "#c5c8c6",
    "operator": "#969896"
  }
}
